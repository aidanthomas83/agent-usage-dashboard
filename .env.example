# Optional Paperclip integration.
# Docker can normally reach a local Paperclip instance on Windows/macOS via:
PAPERCLIP_ENABLED=true
PAPERCLIP_BASE_URL=http://host.docker.internal:3100

# Leave blank when the Paperclip instance exposes exactly one company.
# Set this when multiple companies are visible so attribution is unambiguous.
PAPERCLIP_COMPANY_ID=

# Optional server-side token for Paperclip installations that require API auth.
# Never expose this value in dashboard browser code or commit a populated .env.
PAPERCLIP_API_TOKEN=

# Read-only API timeout in seconds.
PAPERCLIP_TIMEOUT_SECONDS=10
